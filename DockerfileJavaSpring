# Stage 1: Build
FROM maven:3.9-eclipse-temurin-17-alpine AS build
WORKDIR /app
COPY backend/pom.xml .
# Cache dependencies before copying source (faster rebuilds)
RUN mvn dependency:go-offline -q || true
COPY backend/src ./src
RUN mvn package -DskipTests -q

# Stage 2: Runtime
FROM eclipse-temurin:17-jre-alpine
WORKDIR /app

# Create uploads directory — populated at runtime via Docker volume
RUN mkdir -p uploads

COPY --from=build /app/target/shopapp-0.0.1-SNAPSHOT.jar app.jar

EXPOSE 8088
ENTRYPOINT ["java", "-jar", "app.jar"]
# Override with production args via docker-compose command:
# command: ["java", "-Xms256m", "-Xmx512m", "-jar", "app.jar"]
