# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in all values before running.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── Database (TiDB Cloud Serverless — MySQL-compatible) ──────
# Get from: https://tidbcloud.com → Cluster → Connect
SPRING_DATASOURCE_URL=jdbc:mysql://gateway01.us-east-1.prod.aws.tidbcloud.com:4000/ShopApp?serverTimezone=UTC&useSSL=true&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
DB_USERNAME=your_tidb_username.root
DB_PASSWORD=your_tidb_password
MYSQL_DATABASE=ShopApp

# ── Redis (Upstash) ──────────────────────────────────────────
# Get from: https://console.upstash.com → Redis → Details
REDIS_HOST=your-redis-id.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_upstash_redis_password
REDIS_SSL=true

# ── Spring Boot ──────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── JWT secret ───────────────────────────────────────────────
# Generate: openssl rand -base64 32
JWT_SECRET_KEY=your_very_long_random_secret_here

# ── Cloudinary ───────────────────────────────────────────────
# Get from: https://cloudinary.com → Dashboard → API Environment variable
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://123456789:your_api_secret@your_cloud_name

# ── CORS — allowed frontend origins ──────────────────────────
# Add your Vercel domain after deploying frontend
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:4300

# ── Docker images (used by CI/CD) ────────────────────────────
DOCKER_HUB_USERNAME=your_dockerhub_username
APP_IMAGE_BACKEND=your_dockerhub_username/shopapp-spring
APP_IMAGE_FRONTEND=your_dockerhub_username/shopapp-frontend
APP_VERSION=latest
